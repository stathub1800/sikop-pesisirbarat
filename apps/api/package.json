{
  "name": "@sikop/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply sikop --local",
    "db:migrate:remote": "wrangler d1 migrations apply sikop --remote",
    "db:seed:local": "wrangler d1 execute sikop --local --file=../../build/seed.sql",
    "db:seed:remote": "wrangler d1 execute sikop --remote --file=../../build/seed.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@sikop/shared": "*",
    "hono": "^4.13.17",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "vitest": "4.1.12",
    "wrangler": "^4.58.0",
    "@cloudflare/vitest-plugin": "^1.6.0"
  }
}
